---
layout: layouts/base.njk
---
<main class="blog numbered-article" id="main" tabindex="-1">
  <div class="section article-navigation-row">
    <div aria-hidden="true"></div>
    <div class="section-body">
      <div class="section-heading article-navigation">
        <a class="article-back" href="/blog/">← All articles</a>
        <span class="eyebrow">JOURNAL</span>
      </div>
    </div>
  </div>
  <article class="section article-content" aria-labelledby="article-title">
    <div aria-hidden="true"></div>
    <div class="section-body article-sections">
      <header class="article-heading">
        <h1 class="page-title" id="article-title">{{ title | escape }}</h1>
        <p class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
      </header>
      <div class="post-body">
        {{ content | safe }}
      </div>
    </div>
  </article>
</main>
