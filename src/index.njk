---
layout: layouts/base.njk
title: sphoon's portfolio
description: My projects and links. You found them.
navigation: portfolio
permalink: /
---
<div class="background-line" aria-hidden="true" hidden>
  <svg
    viewBox="0 0 1200 1800"
    preserveAspectRatio="none"
    fill="none"
    focusable="false"
  >
    <defs>
      <linearGradient
        id="page-gradient"
        x1="0"
        y1="0"
        x2="1200"
        y2="1800"
        gradientUnits="userSpaceOnUse"
      >
        <stop stop-color="#ff528f" />
        <stop offset=".2" stop-color="#ff8b47" />
        <stop offset=".4" stop-color="#e4ef73" />
        <stop offset=".6" stop-color="#62e3b8" />
        <stop offset=".8" stop-color="#65baff" />
        <stop offset="1" stop-color="#be7bff" />
      </linearGradient>
      <filter
        id="line-text-softness"
        x="-50%"
        y="-100%"
        width="200%"
        height="300%"
      >
        <feGaussianBlur stdDeviation="5" />
      </filter>
      <mask
        id="line-text-fade"
        maskUnits="userSpaceOnUse"
        style="mask-type: luminance"
      >
        <rect
          class="line-mask-base"
          width="1200"
          height="1800"
          fill="#fff"
        />
        <g
          class="line-text-zones"
          fill="#000"
          filter="url(#line-text-softness)"
        ></g>
      </mask>
    </defs>
    <g mask="url(#line-text-fade)">
      <path
        class="routed-line"
        visibility="hidden"
        d="M-80 80 C720 0 1260 0 1260 230 S100 425 100 625 S1100 725 1100 900 C1100 1040 70 905 70 1105 C70 1285 820 1075 820 1375 C820 1535 600 1595 600 1800"
        stroke="url(#page-gradient)"
        stroke-width="8"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
    </g>
  </svg>
</div>
<main id="main">
  <section class="section intro" aria-labelledby="intro-title">
    <div class="rail" aria-hidden="true">
      <span>01</span><span>INTRO</span>
    </div>
    <div class="section-body">
      <p class="eyebrow">EXQUZ3ME / PORTFOLIO</p>
      <div class="hero">
        <h1 id="intro-title">
          <span>Evidence that</span><span>I own a computer.</span>
        </h1>
        <img
          class="hero-dove"
          src="/media/svg/dove.svg"
          width="150"
          height="150"
          alt=""
        />
        <div class="intro-actions">
          <a class="button" href="#work"
            >Explore the work
            <svg
              class="arrow arrow-down"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 19 19 5M5 5h14v14"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="square"
                stroke-linejoin="miter"
              /></svg
          ></a>
          <a class="button" href="#links"
            >Find me elsewhere
            <svg
              class="arrow arrow-down"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 19 19 5M5 5h14v14"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="square"
                stroke-linejoin="miter"
              /></svg
          ></a>
        </div>
      </div>
    </div>
  </section>

