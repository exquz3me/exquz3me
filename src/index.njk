<main class="portfolio" id="main" tabindex="-1">
  <section class="section intro" aria-labelledby="intro-title">
    <div class="rail" aria-hidden="true">
      <span>01</span><span>INTRO</span>
    </div>
    <div class="section-body">
      <p class="eyebrow">PERSONAL INDEX</p>
      <div class="hero">
        <div class="hero-copy">
          <h1 id="intro-title">
            <span>Evidence that</span><span>I own a computer.</span>
          </h1>
          <div class="intro-actions">
            <a class="button" href="#work"
              >Explore the work
              <svg
                class="arrow arrow-down"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M5 19 19 5M5 5h14v14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                /></svg
            ></a>
            <a class="button" href="#links"
              >Find me elsewhere
              <svg
                class="arrow arrow-down"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M5 19 19 5M5 5h14v14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                /></svg
            ></a>
          </div>
        </div>
        <img
          class="hero-dove"
          src="/media/svg/dove.svg"
          width="150"
          height="150"
          alt=""
        />
      </div>
    </div>
  </section>

  <section class="section work" id="work" aria-labelledby="work-title">
    <div class="rail" aria-hidden="true">
      <span>02</span><span>WORK</span>
    </div>
    <div class="section-body">
      <div class="section-heading">
        <h2 id="work-title">Code</h2>
        <span class="eyebrow">GITHUB</span>
      </div>
      <div class="project-grid">
        <a class="project indexed-panel" href="https://github.com/exquz3me">
          <div class="entry-register" aria-hidden="true">
            <span>ENTRY / 001</span><span>PERSONAL</span>
          </div>
          <div class="project-preview">
            <img
              src="/media/svg/placeholder.svg"
              alt=""
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
            />
            <picture class="project-banner">
              <source
                type="image/webp"
                srcset="
                  /media/webp/sphoon/banner-240.webp 240w,
                  /media/webp/sphoon/banner-320.webp 320w,
                  /media/webp/sphoon/banner-480.webp 480w,
                  /media/webp/sphoon/banner-640.webp 640w,
                  /media/webp/sphoon/banner-800.webp 800w,
                  /media/webp/sphoon/banner-960.webp 960w
                "
                sizes="(max-width: 400px) calc(100vw - 42px), (max-width: 700px) calc(90vw - 2px), (max-width: 1440px) calc(40.25vw - 14px), 568px"
              />
              <img
                src="/media/png/sphoon/banner.png"
                alt="sphoon banner artwork."
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div class="project-copy">
            <div class="project-heading">
              <h3>sphoon</h3>
              <svg
                class="arrow project-arrow"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M5 19 19 5M5 5h14v14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                />
              </svg>
            </div>
            <p>Personal repositories, experiments, and maintained code.</p>
            <span class="tags"
              >GITHUB <span aria-hidden="true">/</span> PROFILE</span
            >
          </div>
        </a>
        <a class="project indexed-panel" href="https://github.com/nlobby4">
          <div class="entry-register" aria-hidden="true">
            <span>ENTRY / 002</span><span>COMMUNITY</span>
          </div>
          <div class="project-preview">
            <img
              src="/media/svg/placeholder.svg"
              alt=""
              width="800"
              height="450"
              loading="lazy"
              decoding="async"
            />
            <picture class="project-banner">
              <source
                type="image/webp"
                srcset="
                  /media/webp/nlobby4/banner-240.webp 240w,
                  /media/webp/nlobby4/banner-320.webp 320w,
                  /media/webp/nlobby4/banner-480.webp 480w,
                  /media/webp/nlobby4/banner-640.webp 640w,
                  /media/webp/nlobby4/banner-800.webp 800w,
                  /media/webp/nlobby4/banner-960.webp 960w
                "
                sizes="(max-width: 400px) calc(100vw - 42px), (max-width: 700px) calc(90vw - 2px), (max-width: 1440px) calc(40.25vw - 14px), 568px"
              />
              <img
                src="/media/png/nlobby4/banner.png"
                alt="nlobby4 banner artwork."
                width="960"
                height="540"
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <div class="project-copy">
            <div class="project-heading">
              <h3>nlobby4</h3>
              <svg
                class="arrow project-arrow"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M5 19 19 5M5 5h14v14"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                />
              </svg>
            </div>
            <p>
              Open-source projects and tools for the Flockmod
              community.
            </p>
            <span class="tags"
              >GITHUB <span aria-hidden="true">/</span> ORGANIZATION</span
