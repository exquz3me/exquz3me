# --------------------------
# Custom Rules
#
# Define rules for specific files or directories here.
# Keep general file-type rules in the sections above.
# --------------------------

# Exclude files from exports and source archives
.gitignore               text eol=lf export-ignore
.gitattributes           text eol=lf export-ignore
.gitkeep                 text eol=lf export-ignore
.git-blame-ignore-revs   text eol=lf export-ignore
.gitmessage              text eol=lf export-ignore
.mailmap                 text eol=lf export-ignore

