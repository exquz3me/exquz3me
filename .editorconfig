# --------------------------------------------------
# EditorConfig configuration file.
#
# EditorConfig helps maintain consistent coding styles across editors and IDEs.
# Matching sections are applied from top to bottom, so later settings override
# earlier settings. A closer nested .editorconfig takes precedence over this
# root configuration. Some editors may require a plugin for EditorConfig
# support.
#
# For more information please see:
# https://editorconfig.org/
# --------------------------------------------------

# Stop searching in parent directories
root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
indent_size = 2
max_line_length = 80
